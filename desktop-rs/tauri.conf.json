{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wraithgrid",
  "version": "2.4.0",
  "identifier": "com.cachewraith.wraithgrid",
  "build": {
    "frontendDist": "../out/tauri-renderer",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Wraithgrid",
        "width": 1400,
        "height": 900,
        "minWidth": 420,
        "minHeight": 360,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
